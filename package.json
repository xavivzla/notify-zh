{
  "name": "notify-zh",
  "version": "1.1.0",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "example:start": "cd ./example && bun run start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "size": "size-limit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "husky",
    "prepublishOnly": "npm run test && npm run build",
    "deploy": "npm run prepublishOnly && npm publish",
    "deploy:dry": "npm run prepublishOnly && npm publish --dry-run",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "prettier": {
    "printWidth": 80,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none"
  },
  "author": "Xavier Gonzalez <xavivzla.g@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/xavivzla/notify-zh.git"
  },
  "keywords": [
    "notification",
    "toast",
    "alert",
    "message",
    "popup",
    "zero-dependencies",
    "lightweight",
    "typescript",
    "react",
    "vue",
    "angular",
    "svelte",
    "solid",
    "vanilla-js",
    "browser",
    "ui"
  ],
  "description": "Extremely lightweight (~2.7 KB gzipped), zero-dependency toast notification library with promise support for React, Vue, Angular, Svelte, and Vanilla JS.",
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "3 KB"
    },
    {
      "path": "dist/index.global.js",
      "limit": "3.5 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "prettier": "^3.2.5",
    "size-limit": "^13.0.3",
    "ts-jest": "^29.1.1",
    "tslib": "^2.8.1",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2"
  }
}
