---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import Usage from '../components/Usage.astro'
import Comparison from '../components/Comparison.astro'
import Demo from '../components/Demo.astro'
---

<Layout>
	<Hero />

	<!-- Interactive playground -->
	<Demo />

	<!-- Installation + usage -->
	<Usage />

	<!-- Comparison -->
	<Comparison />

	<!-- Support -->
	<section class="support" id="support" aria-labelledby="support-title">
		<div class="container">
			<h2 id="support-title">Support the project</h2>
			<p class="support-sub">
				notify-zh is free and MIT-licensed. If it saved you a dependency,
				a star or a coffee keeps it moving.
			</p>

			<div class="support-links">
				<a
					href="https://github.com/xavivzla/notify-zh"
					target="_blank"
					rel="noopener"
					class="support-link"
				>
					⭐ Star on GitHub
				</a>
				<a
					href="https://github.com/sponsors/xavivzla"
					target="_blank"
					rel="noopener"
					class="support-link"
				>
					💜 GitHub Sponsors
				</a>
				<a
					href="https://buymeacoffee.com/piratacode"
					target="_blank"
					rel="noopener"
					class="support-link"
				>
					☕ Buy me a coffee
				</a>
			</div>

			<p class="support-note">
				You can also contribute code — issues and PRs welcome on
				<a
					href="https://github.com/xavivzla/notify-zh"
					target="_blank"
					rel="noopener">GitHub</a
				>.
			</p>
		</div>
	</section>
</Layout>

<style>
	.support {
		padding: clamp(56px, 8vw, 96px) 0;
		border-top: 1px solid var(--line);
		text-align: center;
	}

	.support-sub {
		margin: 14px auto 0;
		max-width: 46ch;
		color: var(--ink-soft);
	}

	.support-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
		margin-top: 30px;
	}

	.support-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 12px 24px;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--surface);
		color: var(--ink);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
		transition: background 0.15s ease-out, border-color 0.15s ease-out,
			transform 0.15s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.support-link:hover {
		background: var(--surface-2);
		border-color: oklch(0.42 0.06 268);
		transform: translateY(-1px);
	}

	.support-note {
		margin-top: 26px;
		color: var(--ink-mute);
		font-size: 0.92rem;
	}

	.support-note a {
		color: var(--indigo-text);
		font-weight: 600;
		text-decoration: none;
	}

	.support-note a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
