---

---

<section class="installation" id="install" aria-labelledby="install-title">
    <div class="container">
        <h2 class="installation-title" id="install-title">
            Get Started in Seconds
        </h2>
        <p class="installation-subtitle">
            Choose your preferred installation method and start building amazing
            user experiences.
        </p>

        <div class="install-methods">
            <div class="install-card">
                <h3>📦 NPM</h3>
                <p>Perfect for modern build tools and bundlers</p>
                <div class="code-block">
                    <button
                        class="copy-btn"
                        onclick="copyToClipboard('npm install notify-zh')"
                        >Copy</button
                    >
                    npm install notify-zh
                </div>
            </div>

            <div class="install-card">
                <h3>🌐 CDN</h3>
                <p>Quick setup for prototypes and simple projects</p>
                <div class="code-block">
                    <button
                        class="copy-btn"
                        onclick="copyToClipboard('<script src=&quot;https://unpkg.com/notify-zh&quot;></script>')"
                        >Copy</button
                    >
                    &lt;script src="https://unpkg.com/notify-zh"&gt;&lt;/script&gt;
                </div>
            </div>
        </div>
    </div>
</section>

<section class="usage" id="usage" aria-labelledby="usage-title">
    <div class="container">
        <h2 class="usage-title" id="usage-title">Simple & Powerful API</h2>
        <p class="usage-subtitle">
            Get up and running with just a few lines of code. No complex
            configuration needed.
        </p>

        <div class="tabs-container">
            <!-- Tab Navigation -->
            <div class="tabs-nav">
                <button class="tab-button active" data-tab="vanilla"
                    >Vanilla HTML</button
                >
                <button class="tab-button" data-tab="astro">Astro</button>
                <button class="tab-button" data-tab="react">React</button>
                <button class="tab-button" data-tab="vue">Vue.js</button>
                <button class="tab-button" data-tab="nextjs">Next.js</button>
                <button class="tab-button" data-tab="angular">Angular</button>
            </div>

            <!-- Tab Content -->
            <!-- Vanilla HTML Tab -->
            <div class="tab-content active" id="vanilla-panel">
                <div class="code-block">
                    <button
                        class="copy-btn"
                        onclick="copyToClipboard(vanillaCode)">Copy</button
                    >
                    <pre><code>&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
  &lt;script src="https://unpkg.com/notify-zh"&gt;&lt;/script&gt;
&lt;/head&gt;
&lt;body&gt;
  &lt;script&gt;
    // window.notify is ready to use
    notify.success(&#123; message: 'Operation successful!' &#125;);
    notify.error(&#123; message: 'Something went wrong' &#125;);
    notify.warning(&#123; message: 'Be careful' &#125;);
    notify.info(&#123; message: 'Important information' &#125;);

    // With custom options
    notify.success(&#123;
      message: 'Custom message',
      time: 5000,
      position: 'top-right',
      closable: true
    &#125;);
  &lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;</code></pre>
                </div>
            </div>

            <!-- Astro Tab -->
            <div class="tab-content" id="astro-panel">
                <div class="code-block">
                    <button
                        class="copy-btn"
                        onclick="copyToClipboard(astroCode)">Copy</button
                    >
                    <pre><code>---
// src/pages/index.astro
---

&lt;html&gt;
&lt;head&gt;
  &lt;title&gt;Astro + notify-zh&lt;/title&gt;
&lt;/head&gt;
&lt;body&gt;
  &lt;button id="notify-btn"&gt;Show Notification&lt;/button&gt;
  
  &lt;script&gt;
    import notify from 'notify-zh';

    document.getElementById('notify-btn').addEventListener('click', () =&gt; &#123;
      notify.success(&#123;
        message: 'Hello from Astro!',
        position: 'top-right',
        time: 3000
      &#125;);
    &#125;);
  &lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;</code></pre>
                </div>
            </div>

            <!-- React Tab -->
            <div class="tab-content" id="react-panel">
                <div class="code-block">
                    <button
                        class="copy-btn"
                        onclick="copyToClipboard(reactCode)">Copy</button
                    >
                    <pre><code>import React from 'react';
import notify from 'notify-zh';

function App() &#123;
  const handleClick = () =&gt; &#123;
    notify.success(&#123; message: 'Hello from React!' &#125;);
  &#125;;

  const showError = () =&gt; &#123;
    notify.error(&#123;
      message: 'Something went wrong!',
      time: 5000,
      position: 'bottom-right'
    &#125;);
  &#125;;

  // notify.promise(): loading → success/error automatically
  const saveData = () =&gt; &#123;
    notify.promise(fetch('/api/save'), &#123;
      loading: 'Saving…',
      success: 'Saved!',
      error: 'Failed to save'
    &#125;);
  &#125;;

  return (
    &lt;div&gt;
      &lt;button onClick=&#123;handleClick&#125;&gt;Success&lt;/button&gt;
      &lt;button onClick=&#123;showError&#125;&gt;Error&lt;/button&gt;
      &lt;button onClick=&#123;saveData&#125;&gt;Save (promise)&lt;/button&gt;
    &lt;/div&gt;
  );
&#125;

export default App;</code></pre>
                </div>
            </div>

            <!-- Vue.js Tab -->
            <div class="tab-content" id="vue-panel">
                <div class="code-block">
                    <button class="copy-btn" onclick="copyToClipboard(vueCode)"
                        >Copy</button
                    >
                    <pre><code>&lt;template&gt;
  &lt;div&gt;
    &lt;button @click="showSuccess"&gt;Success&lt;/button&gt;
    &lt;button @click="showError"&gt;Error&lt;/button&gt;
    &lt;button @click="showWarning"&gt;Warning&lt;/button&gt;
    &lt;button @click="showInfo"&gt;Info&lt;/button&gt;
  &lt;/div&gt;
&lt;/template&gt;

&lt;script&gt;
import notify from 'notify-zh';

export default &#123;
  name: 'NotificationDemo',
  methods: &#123;
    showSuccess() &#123;
      notify.success(&#123; message: 'Operation completed successfully!' &#125;);
    &#125;,
    showError() &#123;
      notify.error(&#123; message: 'An error occurred!' &#125;);
    &#125;,
    showWarning() &#123;
      notify.warning(&#123; message: 'Please be careful!' &#125;);
    &#125;,
    showInfo() &#123;
      notify.info(&#123;
        message: 'Here is some information',
        position: 'top-left',
        time: 4000
      &#125;);
    &#125;
  &#125;
&#125;;
&lt;/script&gt;</code></pre>
                </div>
            </div>

            <!-- Next.js Tab -->
            <div class="tab-content" id="nextjs-panel">
                <div class="code-block">
                    <button
                        class="copy-btn"
                        onclick="copyToClipboard(nextjsCode)">Copy</button
                    >
                    <pre><code>// app/page.js (App Router)
'use client';

import notify from 'notify-zh';

export default function Home() &#123;
  // SSR-safe: calls are no-ops on the server, no window guards needed
  const handleSubmit = (e) =&gt; &#123;
    e.preventDefault();

    notify.promise(fetch('/api/submit'), &#123;
      loading: 'Submitting…',
      success: 'Form submitted successfully!',
      error: 'Failed to submit form'
    &#125;);
  &#125;;

  return (
    &lt;div&gt;
      &lt;h1&gt;Next.js + notify-zh&lt;/h1&gt;
      &lt;form onSubmit=&#123;handleSubmit&#125;&gt;
        &lt;button type="submit"&gt;Submit&lt;/button&gt;
      &lt;/form&gt;
    &lt;/div&gt;
  );
&#125;</code></pre>
                </div>
            </div>

            <!-- Angular Tab -->
            <div class="tab-content" id="angular-panel">
                <div class="code-block">
                    <button
                        class="copy-btn"
                        onclick="copyToClipboard(angularCode)">Copy</button
                    >
                    <pre><code>// app.component.ts
import &#123; Component &#125; from '@angular/core';
import notify from 'notify-zh';

@Component(&#123;
  selector: 'app-root',
  template: `
    &lt;div&gt;
      &lt;h1&gt;Angular + notify-zh&lt;/h1&gt;
      &lt;button (click)="showSuccess()"&gt;Success&lt;/button&gt;
      &lt;button (click)="showError()"&gt;Error&lt;/button&gt;
      &lt;button (click)="showWarning()"&gt;Warning&lt;/button&gt;
      &lt;button (click)="showInfo()"&gt;Info&lt;/button&gt;
    &lt;/div&gt;
  `
&#125;)
export class AppComponent &#123;
  title = 'angular-notify-zh';

  showSuccess() &#123;
    notify.success(&#123; message: 'Task completed successfully!' &#125;);
  &#125;

  showError() &#123;
    notify.error(&#123; message: 'An error has occurred!' &#125;);
  &#125;

  showWarning() &#123;
    notify.warning(&#123; message: 'Warning: Please check your input!' &#125;);
  &#125;

  showInfo() &#123;
    notify.info(&#123;
      message: 'Information: Process started',
      time: 6000,
      position: 'center-bottom'
    &#125;);
  &#125;
&#125;</code></pre>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Installation Section */
    .installation {
        padding: clamp(56px, 8vw, 96px) 0;
        border-top: 1px solid var(--line);
    }

    .installation-title {
        text-align: center;
        margin-bottom: 12px;
    }

    .installation-subtitle {
        text-align: center;
        color: var(--ink-soft);
        max-width: 55ch;
        margin: 0 auto 40px;
    }

    .install-methods {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 24px;
        max-width: 800px;
        margin: 0 auto;
    }

    .install-card {
        padding: 24px;
        border: 1px solid var(--line);
        border-radius: var(--radius-card);
        background: var(--surface);
    }

    .install-card h3 {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 8px;
        color: var(--ink);
    }

    .install-card p {
        color: var(--ink-soft);
        font-size: 0.92rem;
        margin-bottom: 14px;
    }

    .code-block {
        background: var(--bg-deep);
        color: var(--ink);
        border: 1px solid var(--line);
        padding: 16px;
        border-radius: var(--radius-toast);
        font-family: var(--font-mono);
        font-size: 14px;
        overflow-x: auto;
        position: relative;
    }

    .copy-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        padding: 4px 12px;
        background: var(--surface-2);
        color: var(--ink-soft);
        border: none;
        border-radius: 999px;
        font-family: inherit;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: color 0.15s ease-out;
    }

    .copy-btn:hover {
        color: var(--ink);
    }

    /* Usage Section */
    .usage {
        padding: clamp(56px, 8vw, 96px) 0;
        border-top: 1px solid var(--line);
    }

    .usage-title {
        text-align: center;
        margin-bottom: 12px;
    }

    .usage-subtitle {
        text-align: center;
        color: var(--ink-soft);
        max-width: 55ch;
        margin: 0 auto 40px;
    }

    /* Tabs System */
    .tabs-container {
        max-width: 800px;
        margin: 0 auto;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-card);
        overflow: hidden;
    }

    .tabs-nav {
        display: flex;
        border-bottom: 1px solid var(--line);
        overflow-x: auto;
    }

    .tab-button {
        flex: 1;
        min-width: 120px;
        padding: 12px 16px;
        background: none;
        border: none;
        font-family: inherit;
        font-size: 14px;
        font-weight: 600;
        color: var(--ink-mute);
        cursor: pointer;
        transition: color 0.15s ease-out;
        border-bottom: 2px solid transparent;
        white-space: nowrap;
    }

    .tab-button:hover {
        color: var(--ink-soft);
    }

    .tab-button.active {
        color: var(--ink);
        border-bottom-color: var(--indigo-bright);
    }

    .tab-content {
        display: none;
        padding: 0;
    }

    .tab-content.active {
        display: block;
    }

    /* Dentro del contenedor de tabs, el borde lo pone el contenedor */
    .tab-content .code-block {
        border: none;
        border-radius: 0;
    }

    .tab-content pre {
        margin: 0;
        border-radius: 0;
        border: none;
    }

    .tab-content code {
        border-radius: 0;
    }

    /* Responsive tabs */
    @media (max-width: 768px) {
        .tabs-nav {
            flex-wrap: wrap;
        }

        .tab-button {
            flex: none;
            min-width: auto;
            padding: 10px 12px;
            font-size: 13px;
        }
    }
</style>

<script is:inline type="module">
    import notify from '/notify-zh.mjs'

    // Code snippets for copy functionality
    window.vanillaCode = `<!DOCTYPE html>
<html>
<head>
  <script src="https://unpkg.com/notify-zh"><\/script>
</head>
<body>
  <script>
    notify.success({ message: 'Operation successful!' });
    notify.error({ message: 'Something went wrong' });
  <\/script>
</body>
</html>`

    window.astroCode = `---
// src/pages/index.astro
---
<script>
  import notify from 'notify-zh';
  notify.success({ message: 'Hello from Astro!' });
<\/script>`

    window.reactCode = `import notify from 'notify-zh';

function App() {
  const handleClick = () => {
    notify.success({ message: 'Hello from React!' });
  };

  const saveData = () => {
    notify.promise(fetch('/api/save'), {
      loading: 'Saving…',
      success: 'Saved!',
      error: 'Failed to save'
    });
  };

  return (
    <div>
      <button onClick={handleClick}>Notify</button>
      <button onClick={saveData}>Save (promise)</button>
    </div>
  );
}`

    window.vueCode = `<template>
  <button @click="show">Notify</button>
</template>
<script>
import notify from 'notify-zh';
export default {
  methods: {
    show() { notify.success({ message: 'Hello!' }); }
  }
}
<\/script>`

    window.nextjsCode = `'use client';

import notify from 'notify-zh';

export default function Home() {
  return (
    <button onClick={() => notify.success({ message: 'Hello!' })}>
      Notify
    </button>
  );
}`

    window.angularCode = `import { Component } from '@angular/core';
import notify from 'notify-zh';

@Component({
  selector: 'app-root',
  template: '<button (click)="show()">Notify</button>'
})
export class AppComponent {
  show() {
    notify.success({ message: 'Hello!' });
  }
}`

    window.copyToClipboard = function (text) {
        navigator.clipboard
            .writeText(text)
            .then(() => {
                notify.success({
                    message: '✅ Copied to clipboard!',
                    time: 1500,
                    position: 'top-right'
                })
            })
            .catch(() => {
                // Fallback for older browsers
                const textArea = document.createElement('textarea')
                textArea.value = text
                document.body.appendChild(textArea)
                textArea.select()
                document.execCommand('copy')
                document.body.removeChild(textArea)
                notify.success({
                    message: '✅ Copied to clipboard!',
                    time: 1500,
                    position: 'top-right'
                })
            })
    }

    // Initialize tabs functionality
    document.addEventListener('DOMContentLoaded', () => {
        const tabButtons = document.querySelectorAll('.tab-button')
        const tabContents = document.querySelectorAll('.tab-content')

        // Set first tab as active by default
        if (tabButtons.length > 0 && tabContents.length > 0) {
            tabButtons[0].classList.add('active')
            tabContents[0].classList.add('active')
        }

        // Add click event listeners to tab buttons
        tabButtons.forEach((button, index) => {
            button.addEventListener('click', () => {
                // Remove active class from all buttons and contents
                tabButtons.forEach((btn) => btn.classList.remove('active'))
                tabContents.forEach((content) =>
                    content.classList.remove('active')
                )

                // Add active class to clicked button and corresponding content
                button.classList.add('active')
                if (tabContents[index]) {
                    tabContents[index].classList.add('active')
                }
            })
        })
    })
</script>
