---
const currentYear = new Date().getFullYear()
---

<footer>
    <div class="container">
        <p class="line">
            &copy; {currentYear} notify-zh · MIT License · Created by
            <a href="https://github.com/xavivzla" target="_blank" rel="noopener">Xavier González</a>
            · An open source library by
            <a href="https://www.trely.agency/librerias/notify-zh" target="_blank" rel="noopener">Trely</a>
        </p>
        <p class="ai-docs">
            Docs for AI assistants: <a href="/llms.txt">llms.txt</a> ·
            <a href="/llms-full.txt">llms-full.txt</a> ·
            <a
                href="https://github.com/xavivzla/notify-zh/blob/master/AGENTS.md"
                target="_blank"
                rel="noopener">AGENTS.md</a>
        </p>
    </div>
</footer>

<style>
    footer {
        padding: 44px 0;
        border-top: 1px solid var(--line);
        text-align: center;
        color: var(--ink-mute);
        font-size: 0.92rem;
    }

    .line {
        color: var(--ink-soft);
    }

    .ai-docs {
        margin-top: 8px;
    }

    a {
        color: var(--indigo-text);
        text-decoration: none;
        font-weight: 500;
    }

    a:hover {
        color: var(--ink);
        text-decoration: underline;
        text-underline-offset: 3px;
    }
</style>
